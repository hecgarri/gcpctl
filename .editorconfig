root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bats}]
indent_style = space
indent_size = 2
shell_variant = bash
binary_next_line = false
switch_case_indent = true

[bin/gcpctl]
indent_style = space
indent_size = 2
shell_variant = bash
switch_case_indent = true

[Makefile]
indent_style = tab
